            "text": "{\"div_captcha\":\"<div class=\\\"form-inline text-left\\\">\\n\\t\\t<div style=\\\"\\\">\\n\\t\\t\\n\\t\\t\\t\\t\\t<img style=\\\"padding-right: 0px;border:1px solid #ccc;\\\" id=\\\"captcha_image\\\" src=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage_show.php?dd6e84fa74e9c3e700e2d036839e1441\\\" alt=\\\"Enter the characters shown in the image, or select the audio Captcha and type the characters you hear.\\\"   tabindex=\\\"0\\\" width=\\\"120\\\"  \\/><div id=\\\"captcha_image_audio_div\\\" style=\\\"display:inline\\\">\\n<audio id=\\\"captcha_image_audio\\\" preload=\\\"none\\\" style=\\\"display: none\\\">\\n<source id=\\\"captcha_image_source_wav\\\" src=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage_play.php?id=6a2bb12667724\\\" type=\\\"audio\\/wav\\\">\\n<object type=\\\"application\\/x-shockwave-flash\\\" data=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage_play.swf?bgcol=%23ffffff&amp;icon_file=images%2Fspeaker-btn.jpg&amp;audio_file=%2Fecourtindia_v6%2Fvendor%2Fsecurimage%2Fsecurimage_play.php%3F\\\" height=\\\"36\\\" width=\\\"36\\\"><param name=\\\"movie\\\" value=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage_play.swf?bgcol=%23ffffff&amp;icon_file=images%2Fspeaker-btn.jpg&amp;audio_file=%2Fecourtindia_v6%2Fvendor%2Fsecurimage%2Fsecurimage_play.php%3F\\\" \\/><\\/object><\\/audio>\\n<\\/div>\\n<div id=\\\"captcha_image_audio_controls\\\"  style=\\\"display:inline-block;\\\">\\n<a tabindex=\\\"0\\\" class=\\\"captcha_play_button\\\" href=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage_play.php?id=6a2bb1266772d\\\" onclick=\\\"return false\\\" role=\\\"button\\\">\\n<img class=\\\"captcha_play_image speaker-btn\\\" height=\\\"34\\\" width=\\\"39\\\" src=\\\"images\\/speaker-btn.jpg\\\" alt=\\\"Play CAPTCHA Audio\\\" style=\\\"border: 0px\\\">\\n<img class=\\\"captcha_loading_image rotating loading\\\" height=\\\"34\\\" width=\\\"39\\\" src=\\\"\\/ecourtindia_v6_source\\/vendor\\/securimage\\/images\\/loading.png\\\" alt=\\\"Loading audio\\\" style=\\\"display: none\\\">\\n<\\/a>\\n<noscript>Enable Javascript for audio controls<\\/noscript>\\n<\\/div>\\n<script type=\\\"text\\/javascript\\\" src=\\\"\\/ecourtindia_v6\\/vendor\\/securimage\\/securimage.js\\\"><\\/script>\\n<script type=\\\"text\\/javascript\\\">captcha_image_audioObj = new SecurimageAudio({ audioElement: 'captcha_image_audio', controlsElement: 'captcha_image_audio_controls' });<\\/script>\\n&nbsp;<a tabindex=\\\"0\\\" style=\\\"border: 0\\\" href=\\\"#\\\" title=\\\"Refresh Image\\\" onclick=\\\"refreshCaptcha()\\\"  role=\\\"button\\\"><img class=\\\"refresh-btn\\\" height=\\\"34\\\" width=\\\"38\\\" src=\\\"images\\/refresh-btn.jpg\\\" alt=\\\"Refresh Image\\\" style=\\\"border: 0px; vertical-align: bottom;margin-bottom: 6px;\\\" \\/><\\/a><\\/div><\\/div>\"}"
